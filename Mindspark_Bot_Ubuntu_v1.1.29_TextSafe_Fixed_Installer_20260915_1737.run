#!/bin/bash
set -eu

APP_NAME="Mindspark Bot"
BASE="$HOME/.local/share/mindspark-bot"
RUNTIME="$BASE/runtime-ubuntu"
VENV="$RUNTIME/venv"
LOG_DIR="$BASE/logs"
LOG_FILE="$LOG_DIR/ubuntu-installer.log"
CHROME_BASE="$BASE/google-chrome"
CHROME_BIN="$CHROME_BASE/opt/google/chrome/chrome"
CHROME_URL="https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"

mkdir -p "$LOG_DIR" "$RUNTIME"
exec 3> >(tee -a "$LOG_FILE")
echo "=== Mindspark Bot Ubuntu installer $(date) ===" >&3
echo >&3
echo "Mindspark Bot Ubuntu Installer v1.1.29" >&3
echo "--------------------------------------" >&3
echo "Checking your Ubuntu system..." >&3
echo >&3

say_info() {
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="$APP_NAME" --width=460 --text="$1" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "$APP_NAME" "$1" || true
    fi
}

say_error() {
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="$APP_NAME" --width=520 --text="$1" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "$APP_NAME" "$1" || true
    fi
}

fail() {
    echo >&3
    echo "ERROR: $1" >&3
    echo "Installer log: $LOG_FILE" >&3
    say_error "$1\n\nInstaller log: $LOG_FILE"
    if [ -t 0 ]; then
        echo >&3
        read -r -p "Press Enter to close this window..." _ || true
    fi
    exit 1
}

# Ubuntu amd64/x86-64 only, matching the official Chrome package used by the bot.
ARCH="$(uname -m 2>/dev/null || true)"
case "$ARCH" in
    x86_64|amd64) ;;
    *) fail "This installer currently supports Ubuntu on x86-64/amd64 only. Detected: $ARCH" ;;
esac

# Make sure the basic desktop/runtime packages exist. pkexec gives a normal GUI password prompt.
need_system=0
command -v python3 >/dev/null 2>&1 || need_system=1
python3 -c 'import tkinter' >/dev/null 2>&1 || need_system=1
python3 -m venv --help >/dev/null 2>&1 || need_system=1
command -v mpg123 >/dev/null 2>&1 || need_system=1
command -v dpkg-deb >/dev/null 2>&1 || need_system=1
command -v fc-cache >/dev/null 2>&1 || need_system=1
command -v zenity >/dev/null 2>&1 || need_system=1

if [ "$need_system" -eq 1 ]; then
    echo "Installing required Ubuntu components..." >&3
    echo "Ubuntu may show an administrator password prompt." >&3
    if ! command -v pkexec >/dev/null 2>&1; then
        fail "Ubuntu needs a few system components, but the graphical administrator prompt (pkexec) is unavailable."
    fi
    pkexec sh -c 'export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y python3 python3-venv python3-tk python3-pip ca-certificates fontconfig mpg123 zenity dpkg' >&3 2>&3 \
        || fail "Ubuntu could not install the required system components."
fi

echo "System check complete." >&3
echo "Preparing Mindspark Bot files..." >&3
say_info "Installing Mindspark Bot for Ubuntu from the current Windows v1.1.29 codebase.\n\nThe MindSpark automation logic is preserved; only Linux compatibility is added."

# Locate the text-safe Base64 payload after this script marker.
# Keeping the payload as printable text avoids corruption by file managers,
# messengers, or transfer layers that can damage a binary-appended .run file.
SELF="$0"
MARKER_LINE="$(awk '/^__MINDS_PARK_PAYLOAD_B64_BELOW__$/ {print NR + 1; exit 0;}' "$SELF")"
[ -n "$MARKER_LINE" ] || fail "Installer payload marker is missing."
TMPDIR="$(mktemp -d -t mindspark-bot-install-XXXXXX)"
trap 'rm -rf "$TMPDIR"' EXIT INT TERM

echo "Verifying embedded installer payload..." >&3
if ! tail -n +"$MARKER_LINE" "$SELF" | tr -d '\r\n' | base64 -d > "$TMPDIR/payload.tar.gz" 2>>"$LOG_FILE"; then
    fail "The embedded installer payload could not be decoded. Please download the installer again."
fi
EXPECTED_PAYLOAD_SHA256="6932a2b0b2d5742225c6a8b1a1105d4eb7625a96b3402d5dff5562520411bf95"
ACTUAL_PAYLOAD_SHA256="$(sha256sum "$TMPDIR/payload.tar.gz" | awk '{print $1}')"
if [ "$ACTUAL_PAYLOAD_SHA256" != "$EXPECTED_PAYLOAD_SHA256" ]; then
    fail "The installer file is incomplete or was changed during transfer. Please download it again."
fi
if ! gzip -t "$TMPDIR/payload.tar.gz" 2>>"$LOG_FILE"; then
    fail "The embedded installer payload is damaged. Please download the installer again."
fi
mkdir -p "$TMPDIR/payload"
tar -xzf "$TMPDIR/payload.tar.gz" -C "$TMPDIR/payload" 2>>"$LOG_FILE" || fail "The embedded installer payload could not be extracted."

# Replace only this user's existing app files. Keep runtime/chrome caches for faster reinstall unless incompatible.
mkdir -p "$BASE"
install -m 0644 "$TMPDIR/payload/mindspark_bot.py" "$BASE/mindspark_bot.py"
install -m 0644 "$TMPDIR/payload/requirements-ubuntu.txt" "$BASE/requirements-ubuntu.txt"
install -m 0755 "$TMPDIR/payload/run-mindspark-bot" "$BASE/run-mindspark-bot"
install -m 0755 "$TMPDIR/payload/uninstall-mindspark-bot" "$BASE/uninstall-mindspark-bot"
install -m 0644 "$TMPDIR/payload/mindspark-bot.svg" "$BASE/mindspark-bot.svg"

# Private Python environment. No bot code is edited here.
if [ ! -x "$VENV/bin/python3" ]; then
    echo "Creating private Python runtime..." >&3
    python3 -m venv "$VENV" >&3 2>&3 || fail "Could not create the private Python runtime."
fi

echo "Installing Python components..." >&3
PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 "$VENV/bin/python3" -m pip install --upgrade pip setuptools wheel >&3 2>&3 \
    || fail "Could not prepare pip in the private runtime. Check your internet connection."
PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 "$VENV/bin/python3" -m pip install -r "$BASE/requirements-ubuntu.txt" >&3 2>&3 \
    || fail "Could not install the bot's Python components. Check your internet connection."
"$VENV/bin/python3" -c 'import openpyxl,cv2,numpy,PIL,playwright; print("Python components OK")' >&3 2>&3 \
    || fail "The private Python environment did not verify correctly."

# Prefer an already-installed Google Chrome. Otherwise keep an official user-local copy for this app.
find_chrome() {
    for p in /usr/bin/google-chrome-stable /usr/bin/google-chrome "$CHROME_BIN"; do
        if [ -x "$p" ]; then printf '%s\n' "$p"; return 0; fi
    done
    command -v google-chrome-stable 2>/dev/null || command -v google-chrome 2>/dev/null || return 1
}

if ! find_chrome >/dev/null 2>&1; then
    echo "Google Chrome was not found. Downloading the official Chrome fallback..." >&3
    CHROME_DEB="$TMPDIR/google-chrome-stable_current_amd64.deb"
    python3 - "$CHROME_URL" "$CHROME_DEB" <<'PY' >&3 2>&3
import shutil, sys, urllib.request
url, dest = sys.argv[1], sys.argv[2]
req = urllib.request.Request(url, headers={'User-Agent':'MindsparkBot-Ubuntu/1.1.29'})
with urllib.request.urlopen(req, timeout=120) as r, open(dest, 'wb') as f:
    shutil.copyfileobj(r, f)
PY
    [ -s "$CHROME_DEB" ] || fail "Google Chrome download failed."
    mkdir -p "$CHROME_BASE"
    rm -rf "$CHROME_BASE/opt" "$CHROME_BASE/usr"
    dpkg-deb -x "$CHROME_DEB" "$CHROME_BASE" >&3 2>&3 || fail "Google Chrome could not be prepared."
    [ -x "$CHROME_BIN" ] || chmod +x "$CHROME_BIN" 2>/dev/null || true
    [ -x "$CHROME_BIN" ] || fail "Google Chrome was downloaded but its executable was not found."
fi

# User-local desktop integration.
mkdir -p "$HOME/.local/share/applications" "$HOME/.local/share/icons/hicolor/scalable/apps"
install -m 0644 "$BASE/mindspark-bot.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/mindspark-bot.svg"
cat > "$HOME/.local/share/applications/mindspark-bot-ubuntu.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Mindspark Bot
Comment=Mindspark automated account workflow
Exec=$BASE/run-mindspark-bot
TryExec=$BASE/run-mindspark-bot
Icon=mindspark-bot
Terminal=false
Categories=Education;Utility;
StartupNotify=true
DESKTOP
chmod 0644 "$HOME/.local/share/applications/mindspark-bot-ubuntu.desktop"
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true

# Verify the installed bot is syntactically valid under the prepared runtime.
"$VENV/bin/python3" -m py_compile "$BASE/mindspark_bot.py" >&3 2>&3 || fail "The installed Ubuntu bot failed its final syntax check."

echo >&3
echo "Installation complete." >&3
echo "Launching Mindspark Bot..." >&3
say_info "Mindspark Bot v1.1.29 for Ubuntu is installed.\n\nYou can now open “Mindspark Bot” from the Ubuntu Applications menu. The bot will start now as well."

nohup "$BASE/run-mindspark-bot" >>"$LOG_FILE" 2>&1 &
echo "Done. You can also open Mindspark Bot later from the Applications menu." >&3
if [ -t 0 ]; then
    sleep 3
fi
exit 0

