#!/bin/bash
set -eu

# File-manager "Run as Program" commonly provides no visible console. Reopen
# inside a terminal so installation progress and any error remain readable.
if [ "${1:-}" != "--terminal-child" ] && [ ! -t 1 ]; then
    if command -v gnome-terminal >/dev/null 2>&1; then
        gnome-terminal --wait -- bash "$0" --terminal-child
        exit $?
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        x-terminal-emulator -e bash "$0" --terminal-child
        exit $?
    fi
fi
if [ "${1:-}" = "--terminal-child" ]; then shift; fi

APP_NAME="Mindspark Bot"
APP_VERSION="1.1.32"
BASE="$HOME/.local/share/mindspark-bot"
RUNTIME="$BASE/runtime-ubuntu"
VENV="$RUNTIME/venv"
LOG_DIR="$BASE/logs"
LOG_FILE="$LOG_DIR/ubuntu-installer.log"
CHROME_BASE="$BASE/google-chrome"
CHROME_BIN="$CHROME_BASE/opt/google/chrome/chrome"
CHROME_URL="https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"

mkdir -p "$LOG_DIR" "$RUNTIME"
exec 3> >(tee -a "$LOG_FILE")
echo "=== Mindspark Bot Ubuntu installer $(date) ===" >&3
echo "Installer 1.1.32-20260916.3 with universal update support" >&3

stage() {
    echo >&3
    echo "[$1]" >&3
}

say_info() {
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="$APP_NAME" --width=500 --text="$1" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "$APP_NAME" "$1" || true
    fi
}

say_error() {
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="$APP_NAME" --width=540 --text="$1" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "$APP_NAME" "$1" || true
    fi
}

fail() {
    echo "ERROR: $1" >&3
    echo "Installer log: $LOG_FILE" >&3
    say_error "$1\n\nInstaller log: $LOG_FILE"
    if [ -t 0 ]; then read -r -p "Press Enter to close..." _ || true; fi
    exit 1
}

[ "$(id -u)" -ne 0 ] || fail "Run this installer as your normal Ubuntu desktop user, without sudo. It will request the administrator password only if Ubuntu components are missing."
case "$(uname -m 2>/dev/null || true)" in
    x86_64|amd64) ;;
    *) fail "This installer supports Ubuntu x86-64/amd64 only." ;;
esac

stage "1/8 Checking Ubuntu system requirements"
need_system=0
command -v python3 >/dev/null 2>&1 || need_system=1
python3 -c 'import tkinter' >/dev/null 2>&1 || need_system=1
python3 -m venv --help >/dev/null 2>&1 || need_system=1
command -v mpg123 >/dev/null 2>&1 || need_system=1
command -v dpkg-deb >/dev/null 2>&1 || need_system=1
command -v fc-cache >/dev/null 2>&1 || need_system=1
command -v zenity >/dev/null 2>&1 || need_system=1
if [ "$need_system" -eq 1 ]; then
    command -v pkexec >/dev/null 2>&1 || fail "Ubuntu system components are missing and pkexec is unavailable."
    echo "Installing required Ubuntu components..." >&3
    pkexec sh -c 'export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y python3 python3-venv python3-tk python3-pip ca-certificates fontconfig fonts-liberation fonts-noto-core mpg123 zenity dpkg' >&3 2>&3 || fail "Ubuntu could not install the required components."
fi

stage "2/8 Verifying the installer payload"
SELF="$0"
MARKER_LINE="$(awk '/^__MINDS_PARK_PAYLOAD_B64_BELOW__$/ {print NR + 1; exit 0;}' "$SELF")"
[ -n "$MARKER_LINE" ] || fail "Installer payload marker is missing."
TEMP_DIR="$(mktemp -d -t mindspark-bot-install-XXXXXX)"
trap 'rm -rf "$TEMP_DIR"' EXIT INT TERM
tail -n +"$MARKER_LINE" "$SELF" | tr -d '\r\n' | base64 -d > "$TEMP_DIR/payload.tar.gz" 2>>"$LOG_FILE" || fail "The installer payload could not be decoded."
EXPECTED_PAYLOAD_SHA256="01c3d823599ac2d62cf866a420ec44e563e5206b637d65eef97571f8cbc3b309"
ACTUAL_PAYLOAD_SHA256="$(sha256sum "$TEMP_DIR/payload.tar.gz" | awk '{print $1}')"
[ "$ACTUAL_PAYLOAD_SHA256" = "$EXPECTED_PAYLOAD_SHA256" ] || fail "The installer was damaged or changed during transfer."
gzip -t "$TEMP_DIR/payload.tar.gz" 2>>"$LOG_FILE" || fail "The installer payload is damaged."
mkdir -p "$TEMP_DIR/payload"
tar -xzf "$TEMP_DIR/payload.tar.gz" -C "$TEMP_DIR/payload" 2>>"$LOG_FILE" || fail "The installer payload could not be extracted."

# Do not replace a bot that is currently running. Legacy releases did not hold
# the new updater lock, so inspect this user's processes before migration.
if pgrep -u "$(id -u)" -af 'python(3)? .*mindspark_bot\.py' >/dev/null 2>&1; then
    fail "Mindspark Bot is running. Finish the active session, close it, then run this installer again."
fi

stage "3/8 Installing Mindspark Bot files"
mkdir -p "$BASE" "$HOME/.local/share/applications" "$HOME/.local/share/icons/hicolor/scalable/apps"
install -m 0755 "$TEMP_DIR/payload/launcher.py" "$BASE/launcher.py"
install -m 0755 "$TEMP_DIR/payload/updater.py" "$BASE/updater.py"
install -m 0755 "$TEMP_DIR/payload/seed_mindspark_bot.py" "$BASE/seed_mindspark_bot.py"
install -m 0755 "$TEMP_DIR/payload/run-mindspark-bot" "$BASE/run-mindspark-bot"
install -m 0755 "$TEMP_DIR/payload/run-mindspark-updater" "$BASE/run-mindspark-updater"
install -m 0755 "$TEMP_DIR/payload/uninstall-mindspark-bot" "$BASE/uninstall-mindspark-bot"
install -m 0644 "$TEMP_DIR/payload/mindspark-bot.svg" "$BASE/mindspark-bot.svg"
install -m 0644 "$TEMP_DIR/payload/requirements-ubuntu.txt" "$BASE/requirements-ubuntu.txt"

# The launcher migrates v1.1.29/v1.1.30/v1.1.31 to the exact v1.1.32 seed,
# retains a backup, and never downgrades a newer installed bot.
stage "4/8 Migrating the existing Ubuntu installation safely"
python3 - "$BASE" <<'PY' >&3 2>&3 || fail "The v1.1.32 bot could not be installed safely."
import sys
from pathlib import Path
base = Path(sys.argv[1])
sys.path.insert(0, str(base))
import launcher
launcher.initialize(base)
PY

if [ ! -x "$VENV/bin/python3" ]; then
    echo "Creating private Python runtime..." >&3
    python3 -m venv "$VENV" >&3 2>&3 || fail "Could not create the private Python runtime."
fi
stage "5/8 Installing private Python dependencies"
PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 "$VENV/bin/python3" -m pip install --upgrade pip setuptools wheel >&3 2>&3 || fail "Could not prepare pip. Check the internet connection."
PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 "$VENV/bin/python3" -m pip install -r "$BASE/requirements-ubuntu.txt" >&3 2>&3 || fail "Could not install the bot's Python components."
"$VENV/bin/python3" -c 'import tkinter,openpyxl; from PIL import Image,ImageTk; from playwright.async_api import async_playwright' >&3 2>&3 || fail "The Python runtime did not verify correctly."
touch "$VENV/.mindspark-ready-v1"

find_chrome() {
    for p in /usr/bin/google-chrome-stable /usr/bin/google-chrome "$CHROME_BIN"; do
        if [ -x "$p" ]; then return 0; fi
    done
    command -v google-chrome-stable >/dev/null 2>&1 || command -v google-chrome >/dev/null 2>&1
}
if ! find_chrome; then
    stage "6/8 Preparing the official Google Chrome fallback"
    echo "Downloading the official Google Chrome fallback..." >&3
    CHROME_DEB="$TEMP_DIR/google-chrome.deb"
    python3 - "$CHROME_URL" "$CHROME_DEB" <<'PY' >&3 2>&3
import shutil, sys, urllib.request
request=urllib.request.Request(sys.argv[1],headers={'User-Agent':'MindsparkBot-Ubuntu/1.1.32'})
with urllib.request.urlopen(request,timeout=120) as response, open(sys.argv[2],'wb') as target:
    shutil.copyfileobj(response,target)
PY
    [ -s "$CHROME_DEB" ] || fail "Google Chrome download failed."
    STAGED_CHROME="$TEMP_DIR/google-chrome"
    mkdir -p "$STAGED_CHROME"
    dpkg-deb -x "$CHROME_DEB" "$STAGED_CHROME" >&3 2>&3 || fail "Google Chrome could not be prepared."
    [ -x "$STAGED_CHROME/opt/google/chrome/chrome" ] || fail "The Chrome package did not contain an executable browser."
    if [ -d "$CHROME_BASE" ]; then mv "$CHROME_BASE" "$BASE/google-chrome.before-run-$(date +%Y%m%d-%H%M%S)"; fi
    mv "$STAGED_CHROME" "$CHROME_BASE"
else
    stage "6/8 Google Chrome is already available"
fi

stage "7/8 Creating application shortcuts"
install -m 0644 "$BASE/mindspark-bot.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/mindspark-bot.svg"
cat > "$HOME/.local/share/applications/mindspark-bot-ubuntu.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Mindspark Bot
Comment=Mindspark automated account workflow
Exec=$BASE/run-mindspark-bot
TryExec=$BASE/run-mindspark-bot
Icon=mindspark-bot
Terminal=true
Categories=Education;Utility;
StartupNotify=true
DESKTOP
cat > "$HOME/.local/share/applications/mindspark-bot-ubuntu-updater.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Mindspark Bot Updates
Comment=Install verified universal Mindspark updates
Exec=$BASE/run-mindspark-updater
TryExec=$BASE/run-mindspark-updater
Icon=mindspark-bot
Terminal=true
Categories=Education;Utility;
StartupNotify=true
DESKTOP
chmod 0644 "$HOME/.local/share/applications/mindspark-bot-ubuntu.desktop" "$HOME/.local/share/applications/mindspark-bot-ubuntu-updater.desktop"
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
stage "8/8 Running final validation"
"$VENV/bin/python3" -m py_compile "$BASE/mindspark_bot.py" "$BASE/launcher.py" "$BASE/updater.py" >&3 2>&3 || fail "Final Python validation failed."

say_info "Mindspark Bot Ubuntu v1.1.32 is installed.\n\nThe launcher accepts verified universal .msupdate releases and selects only the Ubuntu payload. Open Mindspark Bot from Applications."
echo >&3
echo "SUCCESS: Installation complete." >&3
echo "Open Mindspark Bot from the Ubuntu Applications menu." >&3
if [ -t 0 ]; then read -r -p "Press Enter to close..." _ || true; fi
exit 0

