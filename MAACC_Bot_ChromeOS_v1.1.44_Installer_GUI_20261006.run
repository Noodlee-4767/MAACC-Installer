#!/bin/bash
set -eu

if [ "${1:-}" = "" ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v python3 >/dev/null 2>&1 && python3 -c 'import tkinter' >/dev/null 2>&1; then
    python3 - "$0" "ChromeOS" <<'MAACC_GUI_PY'
"""Small desktop setup window embedded in the Ubuntu/ChromeOS .run packages."""
import os
import queue
import subprocess
import sys
import threading
import tkinter as tk
from tkinter import ttk


def main(package, system):
    colors = {'bg':'#0d0f14','panel':'#171c27','text':'#e8ecf3',
              'muted':'#9aa5b5','green':'#39ff88','red':'#ff6470'}
    root = tk.Tk()
    root.title('Mindspark Bot Setup')
    root.geometry('720x560')
    root.resizable(False,False)
    root.configure(bg=colors['bg'])
    tk.Label(root,text='MINDSpark',bg=colors['bg'],fg=colors['green'],
             font=('DejaVu Sans',12,'bold')).place(x=40,y=32)
    tk.Label(root,text='Install Mindspark Bot',bg=colors['bg'],fg=colors['text'],
             font=('DejaVu Sans',23,'bold')).place(x=40,y=80)
    tk.Label(root,text=f'{system}  |  Version 1.1.44',bg=colors['bg'],fg=colors['muted'],
             font=('DejaVu Sans',11)).place(x=42,y=137)
    tk.Label(root,text='Setup checks the package, installs dependencies, and adds an app launcher.',
             bg=colors['bg'],fg=colors['text'],font=('DejaVu Sans',10)).place(x=42,y=180)
    status=tk.StringVar(value='Ready to install')
    status_label=tk.Label(root,textvariable=status,bg=colors['bg'],fg=colors['green'],
                          font=('DejaVu Sans',12,'bold'))
    status_label.place(x=42,y=230)
    style=ttk.Style(root)
    style.theme_use('clam')
    style.configure('Setup.Horizontal.TProgressbar',background=colors['green'],
                    troughcolor=colors['panel'],bordercolor=colors['panel'])
    progress=ttk.Progressbar(root,mode='indeterminate',length=636,
                             style='Setup.Horizontal.TProgressbar')
    progress.place(x=42,y=275)
    log=tk.Text(root,bg=colors['panel'],fg=colors['muted'],insertbackground=colors['text'],
                relief='flat',wrap='word',font=('DejaVu Sans Mono',9),state='disabled')
    log.place(x=42,y=310,width=636,height=150)
    events=queue.Queue()
    running=[False]
    done=[False]

    def append(line):
        log.configure(state='normal')
        log.insert('end',line+'\n')
        log.see('end')
        log.configure(state='disabled')

    def run():
        env=os.environ.copy()
        env['MAACC_INSTALLER_GUI_CHILD']='1'
        try:
            proc=subprocess.Popen(['bash',package,'--console'],stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT,text=True,bufsize=1,env=env)
            for line in proc.stdout:
                events.put(('line',line.rstrip()))
            events.put(('done',proc.wait()))
        except Exception as error:
            events.put(('error',str(error)))

    def install():
        if done[0]:
            command=(os.path.expanduser('~/.local/share/mindspark-bot/run-mindspark-bot')
                     if system=='Ubuntu' else '/usr/bin/mindspark-bot')
            try: subprocess.Popen([command],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            except OSError as error: append('Could not open bot: '+str(error))
            else: root.destroy()
            return
        if running[0]:return
        running[0]=True
        action.configure(state='disabled')
        status.set('Installing and checking dependencies...')
        progress.start(14)
        threading.Thread(target=run,daemon=True).start()

    action=tk.Button(root,text='Install bot',command=install,bg=colors['green'],
                     fg=colors['bg'],activebackground='#1fbf68',relief='flat',
                     font=('DejaVu Sans',10,'bold'),width=16,height=2)
    action.place(x=42,y=480)
    close=tk.Button(root,text='Close',command=root.destroy,bg=colors['panel'],
                    fg=colors['text'],relief='flat',font=('DejaVu Sans',10),width=12,height=2)
    close.place(x=560,y=480)

    def tick():
        try:
            while True:
                kind,value=events.get_nowait()
                if kind=='line':append(value)
                else:
                    running[0]=False
                    progress.stop()
                    action.configure(state='normal')
                    if kind=='done' and value==0:
                        status.set('Installed successfully')
                        action.configure(text='Open bot')
                        done[0]=True
                    else:
                        status.set('Installation needs attention')
                        status_label.configure(fg=colors['red'])
                        append(str(value) if kind=='error' else 'Installer exited with code '+str(value))
                        action.configure(text='Try again')
        except queue.Empty: pass
        root.after(120,tick)

    def closing():
        if running[0]:append('Wait for installation to finish before closing.')
        else:root.destroy()
    root.protocol('WM_DELETE_WINDOW',closing)
    close.configure(command=closing)
    tick()
    root.mainloop()


if __name__=='__main__':
    main(sys.argv[1],sys.argv[2])

MAACC_GUI_PY
    exit $?
fi

SELF="$0"
MARKER_LINE="$(awk '/^__MAACC_DEB_B64_BELOW__$/ {print NR + 1; exit 0;}' "$SELF")"
[ -n "$MARKER_LINE" ] || { echo "Package payload missing" >&2; exit 1; }
TMPDIR="$(mktemp -d -t mindspark-chromeos-XXXXXX)"
trap 'rm -rf "$TMPDIR"' EXIT INT TERM
tail -n +"$MARKER_LINE" "$SELF" | tr -d '\r\n' | base64 -d > "$TMPDIR/mindspark-bot.deb"
EXPECTED_SHA256="48b74c16d7c9d00abed021b6b0ec8fbb32a585789cdbd2fba379c5b4a8db2cfd"
ACTUAL_SHA256="$(sha256sum "$TMPDIR/mindspark-bot.deb" | awk '{print $1}')"
[ "$EXPECTED_SHA256" = "$ACTUAL_SHA256" ] || { echo "The package is incomplete" >&2; exit 1; }
dpkg-deb --info "$TMPDIR/mindspark-bot.deb" >/dev/null
if [ "${1:-}" = "--verify" ]; then
    echo "PASS: ChromeOS installer payload is valid (v1.1.44)."
    exit 0
fi
command -v pkexec >/dev/null 2>&1 || {
    echo "Graphical administrator authorization is unavailable. Open the .deb with the Linux package installer instead." >&2
    exit 1
}
echo "Installing ChromeOS bot package and dependencies..."
pkexec /usr/bin/apt-get install -y "$TMPDIR/mindspark-bot.deb"
echo "Mindspark Bot v1.1.44 is installed. Open it from Linux apps."
exit 0
__MAACC_DEB_B64_BELOW__

