#!/bin/bash
set -eu

if [ "${1:-}" = "" ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v python3 >/dev/null 2>&1 && python3 -c 'import tkinter' >/dev/null 2>&1; then
    python3 - "$0" "Ubuntu" <<'MAACC_GUI_PY'
"""Small desktop setup window embedded in the Ubuntu/ChromeOS .run packages."""
import os
import queue
import subprocess
import sys
import threading
import tkinter as tk
from tkinter import ttk


def main(package, system):
    colors = {'bg':'#0d0f14','panel':'#171c27','text':'#e8ecf3',
              'muted':'#9aa5b5','green':'#39ff88','red':'#ff6470'}
    root = tk.Tk()
    root.title('Mindspark Bot Setup')
    root.geometry('720x560')
    root.resizable(False,False)
    root.configure(bg=colors['bg'])
    tk.Label(root,text='MINDSpark',bg=colors['bg'],fg=colors['green'],
             font=('DejaVu Sans',12,'bold')).place(x=40,y=32)
    tk.Label(root,text='Install Mindspark Bot',bg=colors['bg'],fg=colors['text'],
             font=('DejaVu Sans',23,'bold')).place(x=40,y=80)
    tk.Label(root,text=f'{system}  |  Version 1.1.44',bg=colors['bg'],fg=colors['muted'],
             font=('DejaVu Sans',11)).place(x=42,y=137)
    tk.Label(root,text='Setup checks the package, installs dependencies, and adds an app launcher.',
             bg=colors['bg'],fg=colors['text'],font=('DejaVu Sans',10)).place(x=42,y=180)
    status=tk.StringVar(value='Ready to install')
    status_label=tk.Label(root,textvariable=status,bg=colors['bg'],fg=colors['green'],
                          font=('DejaVu Sans',12,'bold'))
    status_label.place(x=42,y=230)
    style=ttk.Style(root)
    style.theme_use('clam')
    style.configure('Setup.Horizontal.TProgressbar',background=colors['green'],
                    troughcolor=colors['panel'],bordercolor=colors['panel'])
    progress=ttk.Progressbar(root,mode='indeterminate',length=636,
                             style='Setup.Horizontal.TProgressbar')
    progress.place(x=42,y=275)
    log=tk.Text(root,bg=colors['panel'],fg=colors['muted'],insertbackground=colors['text'],
                relief='flat',wrap='word',font=('DejaVu Sans Mono',9),state='disabled')
    log.place(x=42,y=310,width=636,height=150)
    events=queue.Queue()
    running=[False]
    done=[False]

    def append(line):
        log.configure(state='normal')
        log.insert('end',line+'\n')
        log.see('end')
        log.configure(state='disabled')

    def run():
        env=os.environ.copy()
        env['MAACC_INSTALLER_GUI_CHILD']='1'
        try:
            proc=subprocess.Popen(['bash',package,'--console'],stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT,text=True,bufsize=1,env=env)
            for line in proc.stdout:
                events.put(('line',line.rstrip()))
            events.put(('done',proc.wait()))
        except Exception as error:
            events.put(('error',str(error)))

    def install():
        if done[0]:
            command=(os.path.expanduser('~/.local/share/mindspark-bot/run-mindspark-bot')
                     if system=='Ubuntu' else '/usr/bin/mindspark-bot')
            try: subprocess.Popen([command],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            except OSError as error: append('Could not open bot: '+str(error))
            else: root.destroy()
            return
        if running[0]:return
        running[0]=True
        action.configure(state='disabled')
        status.set('Installing and checking dependencies...')
        progress.start(14)
        threading.Thread(target=run,daemon=True).start()

    action=tk.Button(root,text='Install bot',command=install,bg=colors['green'],
                     fg=colors['bg'],activebackground='#1fbf68',relief='flat',
                     font=('DejaVu Sans',10,'bold'),width=16,height=2)
    action.place(x=42,y=480)
    close=tk.Button(root,text='Close',command=root.destroy,bg=colors['panel'],
                    fg=colors['text'],relief='flat',font=('DejaVu Sans',10),width=12,height=2)
    close.place(x=560,y=480)

    def tick():
        try:
            while True:
                kind,value=events.get_nowait()
                if kind=='line':append(value)
                else:
                    running[0]=False
                    progress.stop()
                    action.configure(state='normal')
                    if kind=='done' and value==0:
                        status.set('Installed successfully')
                        action.configure(text='Open bot')
                        done[0]=True
                    else:
                        status.set('Installation needs attention')
                        status_label.configure(fg=colors['red'])
                        append(str(value) if kind=='error' else 'Installer exited with code '+str(value))
                        action.configure(text='Try again')
        except queue.Empty: pass
        root.after(120,tick)

    def closing():
        if running[0]:append('Wait for installation to finish before closing.')
        else:root.destroy()
    root.protocol('WM_DELETE_WINDOW',closing)
    close.configure(command=closing)
    tick()
    root.mainloop()


if __name__=='__main__':
    main(sys.argv[1],sys.argv[2])

MAACC_GUI_PY
    exit $?
fi

APP_NAME="MAACC Bot"
BASE="$HOME/.local/share/mindspark-bot"
LOG_DIR="$BASE/logs"
LOG_FILE="$LOG_DIR/ubuntu-installer.log"

say_info() {
    if [ "${MAACC_INSTALLER_GUI_CHILD:-}" = "1" ]; then echo "$1"; return; fi
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="$APP_NAME" --width=500 --text="$1" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "$APP_NAME" "$1" || true
    fi
}

say_error() {
    if [ "${MAACC_INSTALLER_GUI_CHILD:-}" = "1" ]; then echo "ERROR: $1" >&2; return; fi
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="$APP_NAME" --width=540 --text="$1" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "$APP_NAME" "$1" || true
    fi
}

fail() {
    echo "ERROR: $1" >&2
    say_error "$1"
    exit 1
}

SELF="$0"
MARKER_LINE="$(awk '/^__MAACC_PAYLOAD_B64_BELOW__$/ {print NR + 1; exit 0;}' "$SELF")"
[ -n "$MARKER_LINE" ] || fail "Installer payload marker is missing."
TMPDIR="$(mktemp -d -t maacc-bot-install-XXXXXX)"
trap 'rm -rf "$TMPDIR"' EXIT INT TERM
tail -n +"$MARKER_LINE" "$SELF" | tr -d '\r\n' | base64 -d > "$TMPDIR/payload.tar.gz" || fail "The embedded installer payload could not be decoded."

EXPECTED_PAYLOAD_SHA256="32362d48759ae0b2262791e98a190f275380b7e9dde0a0426d70d64c654b5732"
ACTUAL_PAYLOAD_SHA256="$(sha256sum "$TMPDIR/payload.tar.gz" | awk '{print $1}')"
[ "$ACTUAL_PAYLOAD_SHA256" = "$EXPECTED_PAYLOAD_SHA256" ] || fail "The installer is incomplete or was changed during transfer."
gzip -t "$TMPDIR/payload.tar.gz" || fail "The embedded installer payload is damaged."

if [ "${1:-}" = "--verify" ]; then
    mkdir -p "$TMPDIR/payload"
    tar --no-same-owner -xzf "$TMPDIR/payload.tar.gz" -C "$TMPDIR/payload"
    /usr/bin/python3 -m py_compile "$TMPDIR/payload/launcher.py"
    unzip -t "$TMPDIR/payload/seed_update.msupdate" >/dev/null
    echo "PASS: MAACC Bot Ubuntu installer payload is valid (v1.1.44)."
    exit 0
fi

mkdir -p "$LOG_DIR"
exec 3> >(tee -a "$LOG_FILE")
echo "=== MAACC Bot Ubuntu installer $(date) ===" >&3
echo "Installing MAACC Bot v1.1.44..." >&3

ARCH="$(uname -m 2>/dev/null || true)"
case "$ARCH" in
    x86_64|amd64) ;;
    *) fail "This Ubuntu installer supports x86-64/amd64 only. Detected: $ARCH" ;;
esac

need_system=0
command -v python3 >/dev/null 2>&1 || need_system=1
python3 -c 'import tkinter' >/dev/null 2>&1 || need_system=1
python3 -m venv --help >/dev/null 2>&1 || need_system=1
command -v dpkg-deb >/dev/null 2>&1 || need_system=1
command -v zenity >/dev/null 2>&1 || need_system=1

if [ "$need_system" -eq 1 ]; then
    command -v pkexec >/dev/null 2>&1 || fail "Ubuntu needs system components, but its graphical administrator prompt is unavailable."
    pkexec sh -c 'export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y python3 python3-venv python3-tk python3-pip ca-certificates fontconfig fonts-noto-core fonts-liberation mpg123 zenity dpkg xdg-utils' >&3 2>&3 || fail "Ubuntu could not install the required system components."
fi

mkdir -p "$TMPDIR/payload"
tar --no-same-owner -xzf "$TMPDIR/payload.tar.gz" -C "$TMPDIR/payload" || fail "The installer payload could not be extracted."

# Remove only obsolete files from the earlier direct Ubuntu installer.
rm -rf "$BASE/runtime-ubuntu"
rm -f "$BASE/mindspark_bot.py" "$BASE/requirements-ubuntu.txt" "$BASE/uninstall-mindspark-bot"

mkdir -p "$BASE"
install -m 0644 "$TMPDIR/payload/launcher.py" "$BASE/launcher.py"
install -m 0644 "$TMPDIR/payload/seed_update.msupdate" "$BASE/seed_update.msupdate"
install -m 0755 "$TMPDIR/payload/run-mindspark-bot" "$BASE/run-mindspark-bot"
install -m 0755 "$TMPDIR/payload/run-mindspark-updater" "$BASE/run-mindspark-updater"
install -m 0644 "$TMPDIR/payload/mindspark-bot.svg" "$BASE/mindspark-bot.svg"

python3 - "$BASE/update_config.json" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
path.write_text(json.dumps({
    "manifest_url": "https://raw.githubusercontent.com/Noodlee-4767/Ubuntu-MAACC-Updates/main/Ubuntu-latest.json",
    "auto_check": True,
}, indent=2), encoding="utf-8")
PY

mkdir -p "$HOME/.local/share/applications" "$HOME/.local/share/icons/hicolor/scalable/apps"
install -m 0644 "$BASE/mindspark-bot.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/mindspark-bot.svg"

cat > "$HOME/.local/share/applications/mindspark-bot-ubuntu.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Mindspark Bot
Comment=MAACC Mindspark automated account workflow
Exec=$BASE/run-mindspark-bot
TryExec=$BASE/run-mindspark-bot
Icon=mindspark-bot
Terminal=false
Categories=Education;Utility;
StartupNotify=true
DESKTOP

cat > "$HOME/.local/share/applications/mindspark-bot-updater-ubuntu.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Mindspark Bot Updater
Comment=Update or restore MAACC Mindspark Bot
Exec=$BASE/run-mindspark-updater
TryExec=$BASE/run-mindspark-updater
Icon=mindspark-bot
Terminal=false
Categories=Education;Utility;
StartupNotify=true
DESKTOP

chmod 0644 "$HOME/.local/share/applications/mindspark-bot-ubuntu.desktop" "$HOME/.local/share/applications/mindspark-bot-updater-ubuntu.desktop"
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true

python3 "$BASE/launcher.py" --install-seed >&3 2>&3 || fail "The packaged Ubuntu bot could not be installed."
python3 "$BASE/launcher.py" --prepare-runtime >&3 2>&3 || fail "The private bot runtime could not be prepared. Check your internet connection."
python3 -m py_compile "$BASE/launcher.py" "$BASE/current/mindspark_bot.py" >&3 2>&3 || fail "The installed files failed their final syntax check."

say_info "MAACC Bot v1.1.44 is installed.\n\nThe dedicated Ubuntu updater, in-app Uninstall button, and Full Auto Stop tab cleanup are included."
nohup "$BASE/run-mindspark-bot" >>"$LOG_FILE" 2>&1 &
echo "Installation complete." >&3
exit 0

__MAACC_PAYLOAD_B64_BELOW__

